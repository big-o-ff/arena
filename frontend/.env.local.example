NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000

# Tailscale / remote: use THIS Mac’s Tailscale IP (run: tailscale ip -4) for both lines, same host/port as Daphne.

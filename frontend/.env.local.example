# Tailscale / remote: use THIS Mac’s Tailscale IP (run: tailscale ip -4) for both lines, same host/port as Daphne.
# Example: NEXT_PUBLIC_API_BASE_URL=http://100.x.y.z:8000
#          NEXT_PUBLIC_WS_BASE_URL=ws://100.x.y.z:8000
# Then in backend/.env set DJANGO_ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS to include that IP (and http://100.x.y.z:3001).

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me


DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=bigoff
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
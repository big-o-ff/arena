# Copy to frontend/.env.local
#
# Backend settings live in backend/.env.example. This file used to carry both,
# which made it easy to put Django variables somewhere Django never reads.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Remote / Tailscale: point both URLs at this machine's Tailscale IP
# (`tailscale ip -4`), same host and port as Daphne. Then add that IP to
# DJANGO_ALLOWED_HOSTS and the origin to CORS_ALLOWED_ORIGINS in backend/.env.
#   NEXT_PUBLIC_API_BASE_URL=http://100.x.y.z:8000
#   NEXT_PUBLIC_WS_BASE_URL=ws://100.x.y.z:8000

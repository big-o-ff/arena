# Copy to backend/.env

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# REQUIRED, with no fallback — a shared default key means forgeable sessions.
# Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Defaults to False. Only set this to True on a developer machine; it disables
# HTTPS redirects, HSTS and secure cookies, and turns on full tracebacks.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Clerk — REQUIRED
# ---------------------------------------------------------------------------
# Your Clerk Frontend API origin. This is the `iss` claim on the session tokens
# Clerk issues, and it pins the JWKS endpoint used to verify their signatures.
# Find it in the Clerk dashboard under API Keys → Show JWT public key, or decode
# any session token and read `iss`.
#
# Requests cannot be authenticated without this, by design: the server refuses
# to accept tokens it is unable to verify.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Only needed if your Clerk JWT template sets an `aud` claim. Leave blank otherwise.
CLERK_AUDIENCE=

# Optional. When set, /api/auth/clerk-webhook/ verifies Svix signatures and
# syncs profile changes. When blank the endpoint is disabled and profile sync
# happens through the verified JWT on /api/auth/me/ instead.
CLERK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MYSQL_DATABASE=bigoff
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Redis — channel layer, Celery broker, and the throttling cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Code execution (optional)
# ---------------------------------------------------------------------------
# Wall-clock budgets in seconds. Raise these on slow or heavily loaded judge
# hosts — a box that times out correct submissions is worse than a slow one.
# ARENA_RUN_TIMEOUT=5
# ARENA_COMPILE_TIMEOUT=45
